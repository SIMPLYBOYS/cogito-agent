<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="orchestration-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="cogito-agent · 多 agent 編排流（orchestrator → 同一輪並行三專員 → 整合判斷）" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>

        <mxCell id="3" value="使用者任務&#xa;「審 review-target/payment.go&#xa;能不能上線」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="4" value="🧭 Orchestrator（主 agent）&#xa;&#xa;① read_skill(orchestrate)&#xa;② 先讀檔掌握全貌&#xa;③ 同一輪並行派 3 專員&#xa;ReAct：行動＝spawn_subagent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="270" width="250" height="180" as="geometry" />
        </mxCell>

        <mxCell id="5" value="🤖 correctness 專員&#xa;只審【邏輯正確性】&#xa;比較符號 · off-by-one · 算錢&#xa;抓到：CanRefund 用 &gt; 應為 &gt;=" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="110" width="270" height="120" as="geometry" />
        </mxCell>

        <mxCell id="6" value="🤖 security-auditor 專員&#xa;只審【安全】&#xa;注入 · 憑證外洩 · 授權繞過&#xa;抓到：SQL 注入 + 硬編碼憑證" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="300" width="270" height="120" as="geometry" />
        </mxCell>

        <mxCell id="7" value="🤖 performance 專員&#xa;只審【效能】&#xa;N+1 · 迴圈內 I/O · O(n²)&#xa;抓到：TotalForUser N+1 查詢" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="490" width="270" height="120" as="geometry" />
        </mxCell>

        <mxCell id="8" value="整合（Orchestrator）&#xa;&#xa;收齊 3 份報告&#xa;交叉比對、去重&#xa;→ 產出上線判斷" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="280" width="230" height="160" as="geometry" />
        </mxCell>

        <mxCell id="9" value="🚫 不可上線（NO-GO）&#xa;2 Critical + 1 Bug&#xa;+ 1 效能瓶頸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1460" y="300" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="10" value="🔒 工具邊界＝註冊表 Subset 擋（不是 prompt 求它別寫）&#xa;三專員 tools=[read_file, bash]，連 write_file 都沒有&#xa;各自【隔離 context】、可各用各的模型（opus/high）&#xa;子 agent 臨時、用完即散" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;size=18;" vertex="1" parent="1">
          <mxGeometry x="720" y="650" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="11" value="🛑 政策 Deny＝目標終止（roadmap 2b）&#xa;任一工具呼叫被 policy 拒絕 → 該目標【終止】、回報給人&#xa;不當可重試的工具錯誤 → agent 不會改寫命令繞過黑名單&#xa;（人工拒絕 HITL 例外：人在場，拒絕理由是給它改道用的）" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;size=18;" vertex="1" parent="1">
          <mxGeometry x="1130" y="560" width="400" height="110" as="geometry" />
        </mxCell>

        <mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
