        <mxCell id="4" value="① tools 區　7 核心 + 2 gateway（含 106 行 MCP 目錄）　≈ 6,030 tk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
