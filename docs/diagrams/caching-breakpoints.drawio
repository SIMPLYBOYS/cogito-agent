        <mxCell id="2" value="cogito-agent · Prompt Caching 三斷點 ＋ 錨定式窗口（斷點③補在對話尾端）" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="3" value="每輪送 API 的完整 payload（前綴不變、掛斷點就 0.1x 計費）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
